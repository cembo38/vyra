# ─────────────────────────────────────────────────────────────
# Vyra — environment variables
# Kopieer dit bestand naar .env.local en vul aan waar gewenst.
# De app werkt volledig zonder onderstaande sleutels: AI-functies
# vallen dan terug op deterministische mock-logica en betalingen
# draaien in een demo-flow. Zie README.md voor details.
# ─────────────────────────────────────────────────────────────

# Supabase — echte database + echte accounts (registreren/inloggen).
# Zonder deze twee waarden valt de app terug op de in-memory demo-store
# met één gedeeld demo-account. Zie supabase/migrations/0001_init.sql voor
# het schema dat je in de Supabase SQL Editor moet uitvoeren.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (Claude) — zet deze om echte AI-aanroepen te activeren (Event
# Understanding, Question Generator, Requirement Generator, Timeline/Budget
# Assistant, Event Manager chat, Supplier Response Assistant). Zonder key:
# mock-AI. Haal je sleutel op via console.anthropic.com (eigen, apart
# account/billing — een gewone Claude.ai-abonnement volstaat hier niet).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase service-role key — alléén nodig voor het platformbrede
# admin-dashboard (/admin), dat hiermee alle gebruikers/events kan
# overzien in plaats van alleen die van de ingelogde beheerder zelf.
# Te vinden via Supabase → Settings → API → "service_role" (geheim,
# nooit naar de client sturen, alleen server-side gebruikt).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — zet deze om echte betalingen te activeren. Zonder keys: mock-checkout
# met dezelfde UI/flow, zodat de betaalervaring altijd te demonstreren is.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — zet deze om e-mailmeldingen te activeren (nieuwe aanvraag, nieuwe
# offerte, reactietermijn verlopen). Zonder key: alleen in-app-meldingen,
# precies zoals nu. Account + gratis API-key via resend.com; voor een
# afzenderadres op je eigen domein (bv. notificaties@vyra.now) moet je dat
# domein daar ook verifiëren — zonder verificatie werkt alleen het
# Resend-testadres hieronder als EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=Vyra <onboarding@resend.dev>

# Volledige site-URL — nodig zodat links in e-mails (bv. "Bekijk aanvraag")
# naar de juiste plek wijzen. Laat leeg tijdens lokaal ontwikkelen; zet 'm
# in productie op https://vyra.now.
NEXT_PUBLIC_SITE_URL=https://vyra.now

# Geheime sleutel die de dagelijkse cronjobs (verlopen reactietermijnen +
# het AI-team-dagrapport) gebruiken om zichzelf te identificeren bij
# Vercel — een willekeurige lange tekst, zelf te verzinnen. Zie vercel.json.
CRON_SECRET=

# E-mailadres(sen) die toegang hebben tot /admin — komma-gescheiden bij
# meerdere. BELANGRIJK: dit moet het e-mailadres zijn waarmee je ECHT op
# vyra.now inlogt (niet per se je algemene contact-e-mailadres). Staat dit
# niet gezet, dan valt de app terug op de standaardwaarde in lib/config.ts
# — check die waarde bij twijfel, want een mismatch hier stuurt je
# zonder foutmelding terug naar /events zodra je naar /admin gaat.
ADMIN_EMAILS=

# Toekomstige integraties (nog niet aangesloten in deze MVP-codebase):
# NEXT_PUBLIC_MAPBOX_TOKEN=    # locatie / kaarten
