# ─────────────────────────────────────────────────────────────
# Vyra — environment variables
# Kopieer dit bestand naar .env.local en vul aan waar gewenst.
# De app werkt volledig zonder onderstaande sleutels: AI-functies
# vallen dan terug op deterministische mock-logica en betalingen
# draaien in een demo-flow. Zie README.md voor details.
# ─────────────────────────────────────────────────────────────

# Supabase — echte database + echte accounts (registreren/inloggen).
# Zonder deze twee waarden valt de app terug op de in-memory demo-store
# met één gedeeld demo-account. Zie supabase/migrations/0001_init.sql voor
# het schema dat je in de Supabase SQL Editor moet uitvoeren.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — zet deze om echte AI-aanroepen te activeren (Event Understanding,
# Question Generator, Requirement Generator, Timeline/Budget Assistant,
# Event Manager chat, Supplier Response Assistant). Zonder key: mock-AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe — zet deze om echte betalingen te activeren. Zonder keys: mock-checkout
# met dezelfde UI/flow, zodat de betaalervaring altijd te demonstreren is.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Toekomstige integraties (nog niet aangesloten in deze MVP-codebase):
# RESEND_API_KEY=              # transactionele e-mail
# NEXT_PUBLIC_MAPBOX_TOKEN=    # locatie / kaarten
